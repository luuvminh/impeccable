---
/*
  The first system of the score, engraved rather than illustrated: real SMuFL
  glyphs from Bravura, stems and staff lines drawn to SMuFL's own metrics.
  Pressing it plays the phrase and lights each notehead as it sounds.

  Geometry is in staff spaces x10, so 1 staff space = 10 user units and the
  SMuFL glyph size is 40 (SMuFL defines 1em = 4 staff spaces).
*/

const SS = 10; // staff space
const STAFF_LINE = 1.3; // SMuFL staffLineThickness 0.13
const STEM = 1.2; // SMuFL stemThickness 0.12
const STEM_LEN = 3.5 * SS;
const HEAD_W = 11.8; // noteheadBlack advance

// Treble clef staff positions, top line (F5) = 0.
const PITCH = { C4: 50, D4: 45, E4: 40, F4: 35, G4: 30, A4: 25, B4: 20, C5: 15, D5: 10, E5: 5, F5: 0 };
const HZ = { C4: 261.63, D4: 293.66, E4: 329.63, F4: 349.23, G4: 392.0, A4: 440.0, B4: 493.88, C5: 523.25 };

// An original ascending-then-falling phrase in C — the shape a first lesson
// actually teaches. Bar 1 climbs the triad, bar 2 walks home.
const PHRASE = ['C4', 'E4', 'G4', 'C5', 'B4', 'G4', 'E4', 'C4'];

const X0 = 74; // first notehead
const GAP = 44;
const BAR_AT = 4; // barline after the fourth note

const notes = PHRASE.map((name, i) => {
  const y = PITCH[name as keyof typeof PITCH];
  const x = X0 + i * GAP + (i >= BAR_AT ? 18 : 0);
  return { name, i, x, y, up: y > 20, hz: HZ[name as keyof typeof HZ] };
});

const barX = X0 + BAR_AT * GAP - 14;
const endX = notes[notes.length - 1].x + 40;
---

<figure class="system">
  <figcaption class="system__cap">
    <button type="button" class="system__play" id="play-phrase" aria-describedby="phrase-note">
      <span class="system__play-icon" aria-hidden="true">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M4.5 2.8 12.6 8l-8.1 5.2z" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="system__play-label">Nghe thử một câu</span>
    </button>
    <span class="system__hint" id="phrase-note">Hai ô nhịp đầu của bài học số một</span>
  </figcaption>

  <div class="system__scroll">
    <svg
      class="system__svg"
      viewBox="0 -30 452 100"
      role="img"
      aria-labelledby="phrase-title phrase-desc"
      id="phrase-svg"
    >
      <title id="phrase-title">Hệ thống nhạc đầu tiên của khoá học</title>
      <desc id="phrase-desc">
        Khoá Sol, nhịp bốn bốn, tám nốt đen: Đô, Mi, Sol, Đô cao, Si, Sol, Mi, Đô.
      </desc>

      <!-- staff -->
      {
        [0, 1, 2, 3, 4].map((n) => (
          <rect x="0" y={n * SS - STAFF_LINE / 2} width={endX + 11} height={STAFF_LINE} fill="currentColor" opacity="0.85" />
        ))
      }

      <!-- clef and metre, as real glyphs -->
      <text class="glyph" x="0" y={3 * SS} font-size={4 * SS}>&#xE050;</text>
      <text class="glyph" x="46" y={SS} font-size={4 * SS}>&#xE084;</text>
      <text class="glyph" x="46" y={3 * SS} font-size={4 * SS}>&#xE084;</text>

      <!-- barline after bar one, and the final thin+thick -->
      <rect x={barX} y="0" width="1.6" height={4 * SS} fill="currentColor"></rect>
      <rect x={endX} y="0" width="1.6" height={4 * SS} fill="currentColor"></rect>
      <rect x={endX + 6} y="0" width="5" height={4 * SS} fill="currentColor"></rect>

      {
        notes.map((n) => (
          <g class="note" data-i={n.i}>
            {n.y >= 50 && (
              <rect
                x={n.x - 4.5}
                y={50 - STAFF_LINE / 2}
                width={HEAD_W + 9}
                height={STAFF_LINE}
                fill="currentColor"
              />
            )}
            <rect
              x={n.up ? n.x + HEAD_W - STEM : n.x}
              y={n.up ? n.y - STEM_LEN : n.y}
              width={STEM}
              height={STEM_LEN}
              fill="currentColor"
              class="note__stem"
            />
            <text class="glyph note__head" x={n.x} y={n.y} font-size={4 * SS}>
              &#xE0A4;
            </text>
          </g>
        ))
      }
    </svg>
  </div>
</figure>

<script is:inline define:vars={{ notes }}>
  (() => {
    const btn = document.getElementById('play-phrase');
    const svg = document.getElementById('phrase-svg');
    if (!btn || !svg) return;

    const label = btn.querySelector('.system__play-label');
    const groups = [...svg.querySelectorAll('.note')];
    let ctx = null;
    let playing = false;

    // A struck string: a few decaying partials, not a raw sine.
    function pluck(at, hz) {
      const master = ctx.createGain();
      master.connect(ctx.destination);
      master.gain.setValueAtTime(0.0001, at);
      master.gain.exponentialRampToValueAtTime(0.22, at + 0.012);
      master.gain.exponentialRampToValueAtTime(0.0001, at + 1.15);

      [1, 2, 3, 4.2].forEach((mult, i) => {
        const osc = ctx.createOscillator();
        const g = ctx.createGain();
        osc.type = i === 0 ? 'triangle' : 'sine';
        osc.frequency.value = hz * mult;
        g.gain.value = [1, 0.34, 0.15, 0.06][i];
        osc.connect(g);
        g.connect(master);
        osc.start(at);
        osc.stop(at + 1.2);
      });
    }

    btn.addEventListener('click', async () => {
      if (playing) return;
      ctx = ctx || new (window.AudioContext || window.webkitAudioContext)();
      if (ctx.state === 'suspended') await ctx.resume();

      playing = true;
      btn.setAttribute('aria-disabled', 'true');
      btn.classList.add('is-playing');
      if (label) label.textContent = 'Đang phát';

      const step = 0.46;
      const t0 = ctx.currentTime + 0.06;

      notes.forEach((n, i) => {
        pluck(t0 + i * step, n.hz);
        window.setTimeout(
          () => {
            groups.forEach((g) => g.classList.remove('is-sounding'));
            groups[i]?.classList.add('is-sounding');
          },
          (t0 - ctx.currentTime + i * step) * 1000
        );
      });

      window.setTimeout(
        () => {
          groups.forEach((g) => g.classList.remove('is-sounding'));
          playing = false;
          btn.removeAttribute('aria-disabled');
          btn.classList.remove('is-playing');
          if (label) label.textContent = 'Nghe lại';
        },
        (t0 - ctx.currentTime + notes.length * step + 0.5) * 1000
      );
    });
  })();
</script>

<style>
  .system {
    margin: 0;
    color: var(--ink);
    min-width: 0; /* a grid/flex child must be allowed to shrink below its content */
  }

  .system__scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--s-2);
    scrollbar-width: none;
    min-width: 0;
  }
  .system__scroll::-webkit-scrollbar {
    display: none;
  }

  /* Engraving has a natural size. Letting the system stretch to the full
     column scales one staff space to ~22px and the notation reads as a
     blown-up graphic instead of a printed system. */
  .system__svg {
    width: 100%;
    min-width: 420px;
    max-width: 620px;
    height: auto;
  }

  .glyph {
    font-family: var(--face-music);
    fill: currentColor;
  }

  .note__head,
  .note__stem {
    transition: fill 140ms linear;
  }

  .note.is-sounding .note__head,
  .note.is-sounding .note__stem {
    fill: var(--edit);
  }

  .system__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  .system__play {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem 0.5rem 0.75rem;
    border: 1.5px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--face-text);
    font-size: var(--t-small);
    font-weight: 500;
    cursor: pointer;
    transition:
      background 160ms var(--ease),
      color 160ms var(--ease),
      transform 160ms var(--ease);
  }

  .system__play:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .system__play:active {
    transform: translateY(1px);
  }
  .system__play.is-playing {
    background: var(--edit);
    border-color: var(--edit);
    color: var(--paper);
    cursor: default;
  }

  .system__play-icon {
    display: grid;
    place-items: center;
  }

  .system__hint {
    font-size: var(--t-small);
    color: var(--ink-3);
  }
</style>
